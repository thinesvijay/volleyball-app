# Copy this file to .env.e2e for local authenticated Playwright runs.
# Keep .env.e2e private. Do not commit real usernames or passwords.

E2E_BASE_URL=http://localhost:3000

# Normal player test account
E2E_PLAYER_USERNAME=
E2E_PLAYER_PASSWORD=

# Captain/trainer test account with Player Hub team control access
E2E_CAPTAIN_USERNAME=
E2E_CAPTAIN_PASSWORD=

# Admin account for roster review smoke test
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# Optional: set true only when it is safe for the test to approve the first submitted roster draft.
E2E_APPROVE_ROSTER_DRAFT=false
