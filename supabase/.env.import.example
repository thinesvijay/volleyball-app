# Local-only Supabase shadow import configuration.
# Copy this file to supabase/.env.import and fill real values there.
# Never commit supabase/.env.import or service role keys.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: export from the current Apps Script backend using an admin account.
# Leave blank to generate a manual JSON import template instead.
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_ADMIN_USERNAME=
APPS_SCRIPT_ADMIN_PASSWORD=

# Gitignored export/import working file.
PLAYER_HUB_EXPORT_PATH=supabase/.tmp/player-hub-export.json

# Safety default: import script prints what it would upsert.
# Set to false only when you are ready to write into the Supabase dev project.
SUPABASE_IMPORT_DRY_RUN=true
