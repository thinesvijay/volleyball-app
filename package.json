{
  "name": "volleyball-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "html2canvas": "^1.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "supabase:setup:import-env": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/supabase/setup-import-env.ps1",
    "supabase:export:player-hub": "node scripts/supabase/export-player-hub-from-apps-script.js",
    "supabase:import:player-hub": "node scripts/supabase/import-player-hub-to-supabase.js",
    "supabase:validate:player-hub": "node scripts/supabase/validate-supabase-import.js",
    "supabase:inspect:player-hub": "node scripts/supabase/inspect-player-hub-supabase.js",
    "supabase:snapshot:player-hub": "node scripts/supabase/create-player-hub-supabase-snapshot.js",
    "supabase:compare:player-hub": "node scripts/supabase/compare-player-hub-shadow.js",
    "supabase:test:apps-script-diagnostic": "node scripts/supabase/test-apps-script-supabase-diagnostic.js",
    "supabase:test:player-hub-snapshot-source": "node scripts/supabase/test-player-hub-snapshot-source.js",
    "supabase:test:player-hub-backend-mode": "node scripts/supabase/test-player-hub-backend-mode.js",
    "supabase:test:tournament-backend-mode": "node scripts/supabase/test-tournament-backend-mode.js",
    "supabase:test:team-builder-backend-mode": "node scripts/supabase/test-team-builder-backend-mode.js",
    "supabase:test:auth-backend-mode": "node scripts/supabase/test-auth-backend-mode.js",
    "supabase:test:full-backend-mode": "node scripts/supabase/test-full-backend-mode.js",
    "supabase:beta:read-checklist": "node scripts/supabase/beta-read-session-checklist.js",
    "supabase:shadow:dry-run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/supabase/run-shadow-import-dry-run.ps1",
    "supabase:shadow:real-import": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/supabase/run-shadow-import-real.ps1",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
